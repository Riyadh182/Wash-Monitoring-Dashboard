# Copy this into Streamlit Cloud -> App settings -> Secrets. NEVER commit the real file.
# 1) Google service account (JSON key from Google Cloud) pasted as TOML:
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "wash-dashboard@your-project-id.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

# 2) Google Sheet IDs (the long id in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit)
[sheets]
current = ["PUT_CURRENT_MONTH_SHEET_ID_HERE"]   # one per unit (or one for the pilot unit); holds masters + current logs
archive = []                                    # previous months' sheet IDs, add one each month-end for the Trends/Year view
