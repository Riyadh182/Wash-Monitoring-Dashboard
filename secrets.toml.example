# Copy this file to .streamlit/secrets.toml (local) or paste it in Streamlit Cloud > App settings > Secrets.
# One Google Sheet (Plan Board file) per wash plant. The id is the long text in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
[sheets]
BWL-1  = ""
BWL-2  = ""
CWL-1  = ""
CWL-2  = ""
CWL-3  = ""
CWL-4  = ""
EWDL   = ""
NWL    = ""
SWDL   = ""
SZWDL  = ""

# Option A (easiest): share every sheet as "Anyone with the link - Viewer". Nothing else is needed.
# Option B (private sheets): create a Google service account, share each sheet with its e-mail (Viewer)
# and paste the key here.
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"

# Optional: simple password for the dashboard
# [auth]
# password = "change-me"
